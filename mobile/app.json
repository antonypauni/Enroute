{
  "expo": {
    "name": "En Route",
    "slug": "en-route-rdc",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/enroute-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "cd.enroute.mobile",
      "supportsTablet": false,
      "buildNumber": "2"
    },
    "android": {
      "package": "cd.enroute.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#173e36",
        "foregroundImage": "./assets/enroute-adaptive.png"
      }
    },
    "scheme": "enroute",
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "compileSdkVersion": 36
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choisir une photo facultative pour votre course En Route.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "En Route utilise votre position pour choisir votre départ et, si vous êtes chauffeur, partager votre GPS pendant une course active."
        }
      ],
      "expo-status-bar"
    ],
    "platforms": [
      "android",
      "ios"
    ]
  }
}
